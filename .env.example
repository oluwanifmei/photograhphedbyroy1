PORT=3000
JWT_SECRET=replace_with_a_strong_secret
# Set the owner's real email before using the admin dashboard.
ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:3000
# Public backend URL for email confirmation links, if different from frontend.
PUBLIC_URL=http://localhost:3000
# SQLite is the default. Production requires an explicit path on persistent storage.
# DATABASE_FILE=/var/data/roy.sqlite
# Free hosting: use a private managed Postgres connection string instead of local files.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# First deployment only: enter a private owner password in the hosting dashboard.
# ADMIN_BOOTSTRAP_PASSWORD=
# DATA_FILE is an optional legacy JSON source; keep it when migrating existing data.
# DATA_FILE=/var/data/legacy-data.json
# Public website origin used for canonical links and sitemap.
# SITE_URL=https://your-real-domain.example
# Set only for a frontend on a different site; production HTTPS required.
# CROSS_SITE_COOKIES=true
# The public GitHub Pages build accepts BACKEND_URL (the deployed HTTPS server origin).
# BACKEND_URL=https://your-service.onrender.com

# SMTP settings (for sending confirmation emails). If not set, emails won't be sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=yourpassword
SMTP_FROM="Photographed by Roy" <no-reply@example.com>
