PORT=3000
JWT_SECRET=replace_with_a_strong_secret
# Set the owner's real email before using the admin dashboard.
ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:3000
# Public backend URL for email confirmation links, if different from frontend.
PUBLIC_URL=http://localhost:3000
# Production: use a path on persistent storage. Parent folder must exist.
# DATA_FILE=/var/data/roy/data.json
# Public website origin used for canonical links and sitemap.
# SITE_URL=https://your-real-domain.example
# Set only for a frontend on a different site; production HTTPS required.
# CROSS_SITE_COOKIES=true

# SMTP settings (for sending confirmation emails). If not set, emails won't be sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=yourpassword
SMTP_FROM="Photographed by Roy" <no-reply@example.com>
